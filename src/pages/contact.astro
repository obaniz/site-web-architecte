---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contactez Caroline Guigné Architecte à Bordeaux — 95 rue du Palais Gallien, 33000 Bordeaux. Premier échange gratuit et sans engagement pour votre projet d'architecture."
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <div class="container">
    <h1 class="text-display" style="padding-top: var(--space-lg);">Contact</h1>
    <span class="accent-bar" style="margin: var(--space-sm) 0 var(--space-lg);"></span>

    <div class="contact-grid">
      <div class="contact-form-column">
        <h2 class="text-title contact-form__heading">Envoyer un message</h2>

        <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="172809b6-ced6-43a7-8a59-cb131a8ed710" />
          <input type="hidden" name="subject" value="Nouveau message depuis le site" />
          <input type="hidden" name="from_name" value="Site Caroline Guigne" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

          <label class="contact-form__field">
            <span class="text-label">Nom</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>

          <label class="contact-form__field">
            <span class="text-label">Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>

          <label class="contact-form__field">
            <span class="text-label">Telephone (optionnel)</span>
            <input name="phone" type="tel" autocomplete="tel" />
          </label>

          <label class="contact-form__field">
            <span class="text-label">Sujet</span>
            <select name="subject_type" required>
              <option value="">— Selectionner —</option>
              <option>Construction neuve</option>
              <option>Extension</option>
              <option>Renovation</option>
              <option>Amenagement</option>
              <option>Autre</option>
            </select>
          </label>

          <label class="contact-form__field">
            <span class="text-label">Message</span>
            <textarea name="message" required minlength="10" rows="6"></textarea>
          </label>

          <div class="h-captcha" data-captcha="true"></div>

          <button type="submit" class="contact-form__submit text-label">Envoyer</button>
          <p class="contact-form__status" aria-live="polite"></p>
        </form>

        <div id="contact-success" class="contact-success" hidden>
          <p class="text-body">Merci, votre message a bien été envoyé. Caroline vous répondra dans les plus brefs délais.</p>
        </div>
      </div>

      <div class="contact-right-column">
        <div class="contact-info">
          <div class="contact-block">
            <h2 class="text-label" style="margin-bottom: var(--space-xs);">Téléphone</h2>
            <a href="tel:+33762004212" class="contact-link text-body">07 62 00 42 12</a>
          </div>

          <div class="contact-block">
            <h2 class="text-label" style="margin-bottom: var(--space-xs);">Email</h2>
            <a href="mailto:info@carolineguignearchitecte.com" class="contact-link text-body">info@carolineguignearchitecte.com</a>
          </div>

          <div class="contact-block">
            <h2 class="text-label" style="margin-bottom: var(--space-xs);">Adresse</h2>
            <p class="text-body" style="color: var(--on-surface-secondary);">
              95 Rue du Palais Gallien<br />
              33000 Bordeaux
            </p>
          </div>

          <div class="contact-socials">
            <a href="https://www.instagram.com/caroline_guigne_architecte/" target="_blank" rel="noopener noreferrer" class="text-label contact-social-link">Instagram</a>
            <a href="https://www.linkedin.com/in/caroline-guign%C3%A9-76b41726/" target="_blank" rel="noopener noreferrer" class="text-label contact-social-link">LinkedIn</a>
            <a href="https://bnifrance.fr/fr/memberdetails?encryptedMemberId=iApvVRABBasNJ3qGfkvjgg%3D%3D" target="_blank" rel="noopener noreferrer" class="text-label contact-social-link">BNI</a>
          </div>
        </div>

        <div class="contact-map">
          <a href="https://maps.google.com/?q=95+Rue+du+Palais+Gallien+33000+Bordeaux" target="_blank" rel="noopener noreferrer">
            <img src="/images/contact/map.png" alt="Plan d'accès - 95 Rue du Palais Gallien, Bordeaux" class="contact-map__image" />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>
<script is:inline>
  (function () {
    const form = document.getElementById('contact-form');
    const successBlock = document.getElementById('contact-success');
    const status = form.querySelector('.contact-form__status');
    const submit = form.querySelector('.contact-form__submit');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      status.textContent = '';
      status.removeAttribute('data-state');
      submit.disabled = true;
      submit.textContent = 'Envoi…';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          form.hidden = true;
          successBlock.hidden = false;
          successBlock.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          throw new Error(data.message || 'Erreur inconnue');
        }
      } catch (error) {
        status.textContent = "Une erreur s'est produite. Merci de reessayer ou d'ecrire directement a info@carolineguignearchitecte.com.";
        status.setAttribute('data-state', 'error');
        submit.disabled = false;
        submit.textContent = 'Envoyer';
      }
    });
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .contact-form-column {
    /* Formulaire ajouté en Task 2 */
  }

  .contact-right-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-link {
    color: var(--on-surface-secondary);
    transition: color 0.2s;
  }

  .contact-link:hover {
    color: var(--on-surface);
  }

  .contact-socials {
    display: flex;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }

  .contact-social-link {
    color: var(--on-surface-tertiary);
    transition: color 0.2s;
  }

  .contact-social-link:hover {
    color: var(--on-surface);
  }

  .contact-map {
    background: var(--surface-container);
    min-height: 300px;
  }

  .contact-map__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-form__heading {
    margin-bottom: var(--space-md);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact-form__field input,
  .contact-form__field textarea,
  .contact-form__field select {
    background: var(--surface-container);
    border: 1px solid transparent;
    padding: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 300;
    color: var(--on-surface);
    transition: border-color 0.2s;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus,
  .contact-form__field select:focus {
    border-color: var(--accent);
    outline: none;
  }

  .contact-form__field textarea {
    resize: vertical;
    font-family: var(--font-body);
  }

  .contact-form__submit {
    background: var(--on-surface);
    color: var(--on-dark);
    padding: var(--space-sm) var(--space-lg);
    align-self: flex-start;
    transition: background-color 0.2s, color 0.2s;
  }

  .contact-form__submit:hover {
    background: var(--accent);
    color: var(--on-surface);
  }

  .contact-form__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .contact-form__submit:disabled:hover {
    background: var(--on-surface);
    color: var(--on-dark);
  }

  .contact-form__status {
    color: var(--on-surface-secondary);
    font-size: var(--text-body);
  }

  .contact-form__status[data-state="error"] {
    color: #c0392b;
  }

  .contact-success {
    background: var(--surface-container);
    padding: var(--space-lg);
  }

  @media (max-width: 767px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
