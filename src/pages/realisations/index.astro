---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter((p) => p.data.listed).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Réalisations"
  description="Découvrez les projets réalisés par Caroline Guigné Architecte à Bordeaux : maisons, extensions, rénovations, cabinets médicaux, commerces et ERP. Photos et détails de chaque réalisation."
  breadcrumbs={[{ name: 'Réalisations', href: '/realisations/' }]}
>
  <div class="container">
    <h1 class="sr-only">Réalisations</h1>
    <ProjectFilter />

    <div class="project-grid" id="project-grid">
      {projects.map((project, i) => (
        <div data-categories={project.data.category.join(',')} class="project-card-wrapper">
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            heroImage={project.data.heroImage}
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    padding: var(--space-md) 0 var(--space-xl);
  }

  .project-card-wrapper {
    position: relative;
    overflow: hidden;
    padding-bottom: 56.25%;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
