---
const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/caroline_guigne_architecte/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/caroline-guign%C3%A9-76b41726/' },
  { label: 'BNI', href: 'https://bnifrance.fr/fr/memberdetails?encryptedMemberId=iApvVRABBasNJ3qGfkvjgg%3D%3D' },
];
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <p class="footer__address">
        Caroline Guigné<br />
        95 rue du Palais Gallien<br />
        33000 Bordeaux
      </p>
      <nav class="footer__socials">
        {socialLinks.map((link) => (
          <a href={link.href} class="footer__social-link" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <p class="footer__legal">Diplômée d'État HMONP en architecture, inscrite à l'Ordre</p>
        <img src="/images/logo_ordre_architectes.jpg" alt="Logo de l'Ordre des Architectes" class="footer__ordre-logo" width="320" height="55" loading="lazy" decoding="async" />
      </div>
      <a href="/mentions-legales/" class="footer__legal-link">Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-dark);
    padding: var(--space-lg) 0;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .footer__bottom-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__ordre-logo {
    width: 160px;
    height: auto;
  }

  .footer__address {
    font-size: 0.85rem;
    color: var(--on-dark);
    line-height: 1.6;
  }

  .footer__legal {
    font-size: 0.75rem;
    color: var(--on-surface-tertiary);
    font-style: italic;
  }

  .footer__legal-link {
    font-size: 0.75rem;
    color: var(--on-surface-tertiary);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .footer__legal-link:hover {
    color: var(--on-dark);
    border-bottom-color: var(--accent);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-sm);
  }

  .footer__social-link {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--on-dark);
    transition: color 0.2s;
  }

  .footer__social-link:hover {
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .footer__top {
      flex-direction: column;
      gap: var(--space-md);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .footer__socials {
      flex-wrap: wrap;
    }
  }
</style>
