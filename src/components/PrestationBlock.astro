---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  reversed?: boolean;
  loading?: 'eager' | 'lazy';
}

const { title, description, image, imageAlt, reversed = false, loading = 'lazy' } = Astro.props;
---

<div class:list={['prestation', { 'prestation--reversed': reversed }]}>
  <div class="prestation__image-wrapper">
    <img src={image} alt={imageAlt} class="prestation__image" width="1200" height="900" loading={loading} decoding="async" />
  </div>
  <div class="prestation__text">
    <h2 class="text-title">{title}</h2>
    <span class="accent-bar" style="margin: var(--space-sm) 0;"></span>
    <p class="text-body" style="color: var(--on-surface-secondary);">{description}</p>
  </div>
</div>

<style>
  .prestation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .prestation--reversed .prestation__image-wrapper {
    order: 2;
  }

  .prestation--reversed .prestation__text {
    order: 1;
  }

  .prestation__image-wrapper {
    overflow: hidden;
    background: var(--surface-container);
  }

  .prestation__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .prestation__text {
    background: var(--surface-container);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .prestation {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .prestation--reversed .prestation__image-wrapper {
      order: unset;
    }

    .prestation--reversed .prestation__text {
      order: unset;
    }

    .prestation__text {
      padding: var(--space-sm);
    }
  }
</style>
