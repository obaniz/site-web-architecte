---
interface Props {
  title: string;
  slug: string;
  heroImage: string;
  loading?: 'eager' | 'lazy';
  alt?: string;
}

const { title, slug, heroImage, loading = 'lazy', alt } = Astro.props;
---

<a href={`/realisations/${slug}/`} class="project-card">
  <img src={heroImage} alt={alt || title} class="project-card__image" width="640" height="360" loading={loading} decoding="async" />
  <div class="project-card__overlay">
    <h3 class="project-card__title">{title}</h3>
  </div>
</a>

<style>
  .project-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--surface-container);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 28, 28, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-title);
    color: #fff;
    text-align: center;
    padding: var(--space-sm);
  }

  .project-card:hover .project-card__overlay {
    opacity: 1;
  }

  .project-card:hover .project-card__image {
    transform: scale(1.03);
  }

</style>
