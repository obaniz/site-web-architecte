---
interface Slide {
  image: string;
  alt: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="carousel" id="hero-carousel">
  {slides.map((slide, i) => (
    <div class:list={['carousel__slide', { 'carousel__slide--active': i === 0 }]} data-index={i}>
      <img src={slide.image} alt={slide.alt} class="carousel__image" width="1920" height="1080" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : 'auto'} />
      <div class="carousel__overlay" />
    </div>
  ))}

  <div class="carousel__indicators">
    {slides.map((_, i) => (
      <button
        class:list={['carousel__dot', { 'carousel__dot--active': i === 0 }]}
        data-index={i}
        aria-label={`Slide ${i + 1}`}
      />
    ))}
  </div>
</div>

<style>
  .carousel {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;
    background: var(--surface-dark);
  }

  .carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .carousel__slide--active {
    opacity: 1;
  }

  .carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 28, 28, 0.3) 0%, transparent 30%);
    pointer-events: none;
  }

  .carousel__indicators {
    position: absolute;
    bottom: var(--space-md);
    right: var(--space-lg);
    display: flex;
    gap: var(--space-xs);
  }

  .carousel__dot {
    width: 12px;
    height: 12px;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }

  .carousel__dot--active {
    background: var(--accent);
  }

  @media (max-width: 767px) {
    .carousel {
      height: 50vh;
      min-height: 320px;
    }

.carousel__indicators {
      right: var(--space-md);
      bottom: var(--space-sm);
    }
  }
</style>

<script>
  const carousel = document.getElementById('hero-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll('.carousel__slide');
    const dots = carousel.querySelectorAll('.carousel__dot');
    let current = 0;
    let interval: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('carousel__slide--active');
      dots[current].classList.remove('carousel__dot--active');
      current = index;
      slides[current].classList.add('carousel__slide--active');
      dots[current].classList.add('carousel__dot--active');
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    function startAutoplay() {
      interval = setInterval(next, 5000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        clearInterval(interval);
        goTo(Number((dot as HTMLElement).dataset.index));
        startAutoplay();
      });
    });

    startAutoplay();
  }
</script>
